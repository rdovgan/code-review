# AI provider: "claude" or "glm"
AI_PROVIDER=claude

# Claude (Anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
AI_MODEL=claude-sonnet-4-6

# GLM (Z.AI) — used when AI_PROVIDER=glm
ZAI_API_KEY=your-zai-api-key-here
# General API: https://api.z.ai/api/paas/v4
# Coding Plan: https://api.z.ai/api/coding/paas/v4
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5-turbo

AI_MAX_TOKENS=4096
AI_MAX_DIFF_TOKENS=8000
# Reasoning models on GLM (glm-5.3-flash, ~45 tokens/s): keep AI_MAX_DIFF_TOKENS about 15000 and
# AI_FILE_CONTEXT_MAX_CHARS about 60000, or one diff request takes longer than its timeout
# AI_FILE_CONTEXT_MAX_CHARS=60000
# Read timeout cap of one AI request (diff, verify, final answer); near a deadline it is shorter
# AI_REQUEST_TIMEOUT_SECONDS=420
# Agentic review: parts run at once (lower if Z.AI returns 429), tool-turn timeout, GLM thinking
# for the final answer (auto | disabled | enabled)
# AGENT_PARALLEL_PARTS=3
# AGENT_STEP_TIMEOUT_SECONDS=180
# GLM_ANSWER_THINKING=auto

# Redis
REDIS_URL=redis://localhost:6379/0

# Docker Compose: Redis password (CHANGE THIS IN PRODUCTION!)
REDIS_PASSWORD=your_secure_redis_password_here

# Review limits
MAX_DIFF_LINES=500
AI_DAILY_TOKEN_BUDGET=100000  # input+output tokens per day; 0 = unlimited

# Bitbucket credentials are stored per-workspace in config/credentials.yml
# See config/credentials.yml.example

# Mattermost Incoming Webhook URL used for author-based PR notifications
# System Console > Integrations > Incoming Webhooks
MATTERMOST_WEBHOOK_URL=
