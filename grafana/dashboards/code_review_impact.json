        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "description": "Total pull requests analyzed across all projects",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true,
        "noValue": "0"
      },
      "targets": [
        {
          "expr": "sum(code_review_reviews_total{status!=\"skipped\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "PRs Reviewed",
      "type": "stat"
    },
    {
      "description": "Total code quality issues detected by Semgrep and AI analysis",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true,
        "noValue": "0"
      },
      "targets": [
        {
          "expr": "sum(code_review_findings_total)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Issues Detected",
      "type": "stat"
    },
    {
      "description": "Issues that could cause production failures, security vulnerabilities, or incorrect behavior",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true,
        "noValue": "0"
      },
      "targets": [
        {
          "expr": "sum(code_review_findings_total{severity=~\"critical|bug\"})",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Critical & Bugs Caught",
      "type": "stat"
    },
    {
      "description": "Estimated developer time saved — 15 min base per PR reviewed, plus 3 min per finding beyond 5 in a single PR",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true,
        "noValue": "0"
      },
      "targets": [
        {
          "expr": "round((sum(code_review_reviews_total{status!=\"skipped\"}) * 15 + sum(code_review_extra_findings_total) * 3) / 60, 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Hours Saved (est.)",
      "type": "stat"
    },

    {
      "description": "Percentage of reviews that passed without blocking issues",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "id": 5,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "expr": "round(sum(code_review_reviews_total{status=\"success\"}) / clamp_min(sum(code_review_reviews_total{status!=\"skipped\"}), 1) * 100, 1)",
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Review Success Rate",
      "type": "gauge"
    },
    {
      "description": "Number of repositories with at least one review processed",
