        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "value",
        "wideLayout": true,
        "noValue": "0"
      },
      "targets": [
        {
          "expr": "count(count by (project) (code_review_reviews_by_project_total))",
