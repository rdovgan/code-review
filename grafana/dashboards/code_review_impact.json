              { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "light-red", "value": 1 }] } }
            ]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 29 },
      "id": 14,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Reviews" }]
      },
      "targets": [
        { "expr": "sum by (project) (code_review_reviews_by_project_total{status!=\"skipped\"})", "format": "table", "instant": true, "legendFormat": "", "refId": "A" },
        { "expr": "code_review_findings_by_project_total{severity=\"critical\"}", "format": "table", "instant": true, "legendFormat": "", "refId": "B" },
        { "expr": "code_review_findings_by_project_total{severity=\"bug\"}", "format": "table", "instant": true, "legendFormat": "", "refId": "C" },
        { "expr": "code_review_findings_by_project_total{severity=\"performance\"}", "format": "table", "instant": true, "legendFormat": "", "refId": "D" },
        { "expr": "code_review_findings_by_project_total{severity=\"suggestion\"}", "format": "table", "instant": true, "legendFormat": "", "refId": "E" }
      ],
      "title": "Project Summary",
      "transformations": [
        { "id": "joinByField", "options": { "byField": "project" } },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true, "Time 1": true, "Time 2": true, "Time 3": true, "Time 4": true, "Time 5": true,
              "__name__": true, "instance": true, "job": true, "severity": true, "status": true
            },
            "renameByName": {
              "Value #A": "Reviews",
              "Value #B": "Critical",
              "Value #C": "Bug",
              "Value #D": "Performance",
              "Value #E": "Suggestion",
              "project": "Project"
            }
          }
        }
      ],
      "type": "table"
    },
