      "targetBlank": false,
      "title": "Code Review Bot dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Success Rate %" },
            "properties": [{ "id": "unit", "value": "percent" }]
          },
          {
            "matcher": { "id": "byName", "options": "Avg Duration (s)" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": ["sum"],
          "show": false
        },
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Total PRs" }]
      },
      "pluginVersion": "10.4.2",
      "targets": [
        {
          "expr": "sum by (project) (code_review_reviews_by_project_total)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        },
        {
          "expr": "round(sum by (project) (code_review_reviews_by_project_total{status=\"success\"}) / clamp_min(sum by (project) (code_review_reviews_by_project_total{status!=\"skipped\"}), 1) * 100, 1)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "B"
        },
        {
          "expr": "round(sum by (project) (code_review_duration_by_project_milliseconds_sum) / clamp_min(sum by (project) (code_review_duration_by_project_milliseconds_count), 1) / 1000, 1)",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "C"
        },
        {
          "expr": "round(sum by (project) (increase(code_review_findings_by_project_total{severity=\"critical\"}[7d])))",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "D"
        }
      ],
      "title": "Project Health Summary",
      "transformations": [
        {
          "id": "joinByField",
          "options": { "byField": "project" }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "status": true,
              "severity": true
            },
            "renameByName": {
              "Value #A": "Total PRs",
              "Value #B": "Success Rate %",
              "Value #C": "Avg Duration (s)",
              "Value #D": "Critical (7d)",
              "project": "Project"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "id": 100,
      "title": "Trends",
      "type": "row"
    },
    {
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
