      },
      "targets": [
        {
          "expr": "sum by (project) (rate(code_review_duration_by_project_milliseconds_sum[30m])) / clamp_min(sum by (project) (rate(code_review_duration_by_project_milliseconds_count[30m])), 1) / 1000",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ],
      "title": "Avg Review Duration by Project (rolling 30m)",
      "type": "timeseries"
