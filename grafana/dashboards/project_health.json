        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (project) (increase(code_review_findings_by_project_total{severity=\"critical\"}[1h]))",
          "legendFormat": "{{project}}",
          "refId": "A"
        }
      ],
      "title": "Critical Findings Trend by Project",
      "type": "timeseries"
    },
    {
